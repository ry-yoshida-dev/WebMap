{
  "name": "@web-map/restricted-basemaps",
  "version": "0.1.1",
  "description": "Optional WebMap basemaps whose terms restrict commercial use or require a key.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ry-yoshida-dev/WebMap.git",
    "directory": "packages/restricted-basemaps"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@web-map/core": "0.1.1"
  }
}
